# Supabase — copy to .env and fill with your project credentials
# Dashboard: https://supabase.com/dashboard/project/_/settings/api

# Public (browser + server reads via CDA)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser (CMA admin + portal user management)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# First principal/admin user email (create in Supabase Auth → Users, then set profile role)
ADMIN_EMAIL=admin@gpw.edu.in

# ---------------------------------------------------------------------------
# GPW AI Assistant (server-only — never expose to the browser)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=700

# ---------------------------------------------------------------------------
# Supabase Auth setup (Dashboard → Authentication)
# ---------------------------------------------------------------------------
# 1. Email OTP: enable Email provider, configure SMTP (Settings → Auth → SMTP)
# 2. Google OAuth: Auth → Providers → Google (add Client ID/Secret from Google Cloud)
# 3. Redirect URLs (Auth → URL Configuration):
#    Production (Vercel):
#    - Site URL: https://shafqat-seven.vercel.app
#    - Redirect URLs:
#        https://shafqat-seven.vercel.app/auth/callback
#        https://shafqat-seven.vercel.app/login
#        https://shafqat-seven.vercel.app/signup
#        https://shafqat-seven.vercel.app/admin/login
#    Local dev (optional, add alongside production):
#    - Site URL: http://localhost:3000
#    - Redirect URLs:
#        http://localhost:3000/auth/callback
#        http://localhost:3000/login
#        http://localhost:3000/signup
#        http://localhost:3000/admin/login
# 4. Run migration: supabase db push  (or apply SQL in dashboard)
# ---------------------------------------------------------------------------
# Production portal bootstrap (run once after migrations)
# ---------------------------------------------------------------------------
# 1. Apply migrations: npm run supabase:push  (or SQL in dashboard)
# 2. Seed CMS data: run supabase/seed.sql in SQL editor (departments auto-sync on first portal load too)
# 3. Create Principal in Supabase Auth → Users (email + password, email confirmed)
# 4. SQL: update public.profiles set role = 'principal', approval_status = 'n/a' where email = 'your@email.com';
# 5. Principal signs in → /portal → add HOD for each department → HODs add staff
# 6. Students sign up (/signup) → complete onboarding → HOD/staff approve → /student portal

# ---------------------------------------------------------------------------
# Media storage (Supabase Dashboard → Storage)
# ---------------------------------------------------------------------------
# Bucket name: Content-GPWS (public read, admin write via RLS)
# Upload/manage files in Admin → Media tab after applying migration 20260901140000_media_assets.sql
# Folders: images, videos, documents, syllabus, timetables

# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<from `npm run supabase:status`>
# SUPABASE_SERVICE_ROLE_KEY=<service_role key from status>
