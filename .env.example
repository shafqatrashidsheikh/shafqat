# Supabase — copy to .env and fill with your project credentials
# Dashboard: https://supabase.com/dashboard/project/_/settings/api

# Public (browser + server reads via CDA)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser (CMA admin + portal user management)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# First principal/admin user email (create in Supabase Auth → Users, then set profile role)
ADMIN_EMAIL=admin@gpw.edu.in

# ---------------------------------------------------------------------------
# GPW AI Assistant (server-only — never expose to the browser)
# ---------------------------------------------------------------------------
# OpenAI: OPENAI_API_KEY=sk-...  (https://platform.openai.com/api-keys)
# Groq:   OPENAI_API_KEY=gsk_... (https://console.groq.com/keys)
#         Groq keys are auto-detected (gsk_...) and use api.groq.com
# Optional: AI_BASE_URL / AI_PROVIDER=groq|openai / GROQ_API_KEY
# Vision (image understand): qwen/qwen3.8-27b and qwen/qwen3.6-27b accept images on Groq.
# Optional override if you use a different multimodal model:
# AI_VISION_MODEL=qwen/qwen3.8-27b
# OpenAI: gpt-4o-mini works for vision; also enables DALL·E image generation.
# Restart `npm run dev` after saving .env
OPENAI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
AI_MAX_OUTPUT_TOKENS=700
# AI_VISION_MODEL=

# ---------------------------------------------------------------------------
# Supabase Auth setup (Dashboard → Authentication)
# ---------------------------------------------------------------------------
# Magic link / OTP email will fail with "Error sending magic link email" until SMTP works.
# This is almost always an SMTP provider failure (not Redirect URLs) — check Auth → Logs.
# 1. Authentication → SMTP Settings: enable custom SMTP (Resend/Brevo recommended).
#    - Host with NO trailing spaces (e.g. smtp.resend.com)
#    - Port 465 or 587 matching your provider
#    - Verified sender domain / from address
# 2. Authentication → Email Templates: Magic Link / Confirm signup must include {{ .Token }}
#    (this app verifies a 6-digit OTP code, not a clicked link)
# 3. Redirect URLs (Auth → URL Configuration) — needed for Google OAuth & magic links:
#    Production:
#    - Site URL: https://YOUR-PRODUCTION-DOMAIN
#    - Redirect URLs:
#        https://YOUR-PRODUCTION-DOMAIN/**
#        https://YOUR-PRODUCTION-DOMAIN/auth/callback
#        https://YOUR-PRODUCTION-DOMAIN/login
#        https://YOUR-PRODUCTION-DOMAIN/signup
#        https://YOUR-PRODUCTION-DOMAIN/admin/login
#    Local (optional):
#    - http://localhost:3000/**
#    - http://localhost:3000/auth/callback
# 4. Prefer "Sign up with Google" if email SMTP is still failing.
# ---------------------------------------------------------------------------
# Production portal bootstrap (run once after migrations)
# ---------------------------------------------------------------------------
# 1. Apply migrations: npm run supabase:push  (or SQL in dashboard)
# 2. Seed CMS data: run supabase/seed.sql in SQL editor (departments auto-sync on first portal load too)
# 3. Create Principal in Supabase Auth → Users (email + password, email confirmed)
# 4. SQL: update public.profiles set role = 'principal', approval_status = 'n/a' where email = 'your@email.com';
# 5. Principal signs in → /portal → add HOD for each department → HODs add staff
# 6. Students sign up (/signup) → complete onboarding → HOD/staff approve → /student portal

# ---------------------------------------------------------------------------
# Media storage (Supabase Dashboard → Storage)
# ---------------------------------------------------------------------------
# Bucket name: Content-GPWS (public read, admin write via RLS)
# Upload/manage files in Admin → Media tab after applying migration 20260901140000_media_assets.sql
# Folders: images, videos, documents, syllabus, timetables

# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<from `npm run supabase:status`>
# SUPABASE_SERVICE_ROLE_KEY=<service_role key from status>
